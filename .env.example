# -----------------------------------------------------------------------------
# SDP - Sistema de Protocolos & Requerimentos (IFBA - Campus Seabra)
# Arquivo de Configuração Local (.env)
# -----------------------------------------------------------------------------

APP_NAME="SDP - IFBA Seabra"
APP_ENV=local
APP_KEY=key
APP_DEBUG=true
APP_TIMEZONE="America/Bahia"
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE= #user
DB_USERNAME= #senha
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=[EMAIL_ADDRESS]
MAIL_FROM_NAME="SDP - IFBA Seabra"

SUAP_BASE_URL="https://suap.ifba.edu.br"
SUAP_API_URL="https://suap.ifba.edu.br/api/v2"
SUAP_TIMEOUT_SECONDS=10
PLAYWRIGHT_HEADLESS=true

FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"
