# -----------------------------------------------------------------------------
# SDP - Sistema de Protocolos & Requerimentos (IFBA - Campus Seabra)
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# -----------------------------------------------------------------------------

# --- Configurações da Aplicação ---
APP_NAME="SDP - IFBA Seabra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="America/Bahia"
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# --- Manutenção e Logs ---
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco de Dados ---

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sdp_ifba
DB_USERNAME=root
DB_PASSWORD=

# --- Sessão, Cache e Filas ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

# --- Configuração de Envio de E-mails (SMTP) ---
# Em desenvolvimento local, você pode usar 'log', Mailpit (1025) ou SMTP real
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@ifba.edu.br
MAIL_PASSWORD=sua-senha-de-aplicativo
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="protocolos.seabra@ifba.edu.br"
MAIL_FROM_NAME="SDP - IFBA Seabra"

# --- E-mails dos Setores Responsáveis (IFBA Campus Seabra) ---
MAIL_SETOR_CORES=""
# --- Integração e Scraping do SUAP ---
SUAP_BASE_URL="https://suap.ifba.edu.br"
SUAP_API_URL="https://suap.ifba.edu.br/api/v2"
SUAP_TIMEOUT_SECONDS=10
PLAYWRIGHT_HEADLESS=true

# --- Armazenamento de Arquivos / Upload de Anexos ---
FILESYSTEM_DISK=local

# --- Configurações do Vite ---
VITE_APP_NAME="${APP_NAME}"
